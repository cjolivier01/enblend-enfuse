# BUILD file for src/dynamic_loader/ directory

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//src:__subpackages__"])

cc_library(
    name = "dynamic_loader",
    srcs = glob(["*.cc"]),
    hdrs = glob(["*.h"]),
    copts = [
        "-std=c++11",
        "-Wall",
        "-O2",
        "-D_GNU_SOURCE",
        "-D_FILE_OFFSET_BITS=64",
    ],
    linkopts = ["-ldl"],  # For dlopen, dlsym, etc.
)
