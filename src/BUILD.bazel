# All common source files (adjust based on actual files in src/)
COMMON_SRCS = [
    "alternativepercentage.cc",
    "error_message.cc",
    "filenameparse.cc",
    "filespec.cc",
    "introspection.cc",
    "mersenne.cc",
    "metadata.cc",
    "parameter.cc",
    "path.cc",
    "progress_display.cc",
    "self_test.cc",
    "tiff_message.cc",
    "timer.cc",
]

# Enblend-specific sources
ENBLEND_SRCS = [
    "gpu.cc",
    "nearest.cc",
    "optimizer.cc",
    "minimizer.cc",
]

# Enfuse-specific sources
ENFUSE_SRCS = [
    "exposure_weight.cc",
]

# OpenCL sources (optional)
OPENCL_SRCS = [
    "opencl.cc",
    "opencl_exposure_weight.cc",
]

# Layer selection sources (if they exist in src/ rather than subdirectory)
LAYER_SELECTION_SRCS = glob([
    "**/layer_selection*.cc",
    "**/LayerSelection*.cc",
    "**/BatchNorm.cc",
    "**/DataSet.cc",
    "**/ExposureSensor.cc",
    "**/HistogramMatching.cc",
    "**/MLFSwMI.cc",
    "**/Measure.cc",
    "**/Regularization.cc",
], allow_empty = True)

# Common library with headers
cc_library(
    name = "common_headers",
    hdrs = glob([
        "*.h",
        "*.hxx",
    ]) + [
        "signature.h",
        "//:config.h",
    ],
    includes = ["."],
    deps = [
        "@boost//:filesystem",
        "@boost//:system",
        "@gsl//:gsl",
        "@vigra//:vigra",
    ],
)

# Enblend binary
cc_binary(
    name = "enblend",
    srcs = ["enblend.cc"] + COMMON_SRCS + ENBLEND_SRCS + LAYER_SELECTION_SRCS,
    copts = ENBLEND_COPTS,
    linkopts = [
        "-lm",
        "-lpthread",
    ],
    deps = [
        ":common_headers",
        "@libtiff//:tiff",
        "@libjpeg//:jpeg",
        "@libpng//:png",
        "@lcms2//:lcms2",
    ] + select({
        "@//:with_openexr": ["@openexr//:openexr"],
        "//conditions:default": [],
    }) + select({
        "@//:with_exiv2": ["@exiv2//:exiv2"],
        "//conditions:default": [],
    }),
)

# Enfuse binary
cc_binary(
    name = "enfuse",
    srcs = ["enfuse.cc"] + COMMON_SRCS + ENFUSE_SRCS,
    copts = ENFUSE_COPTS,
    linkopts = [
        "-lm",
        "-lpthread",
    ],
    deps = [
        ":common_headers",
        "@libtiff//:tiff",
        "@libjpeg//:jpeg",
        "@libpng//:png",
        "@lcms2//:lcms2",
    ] + select({
        "@//:with_openexr": ["@openexr//:openexr"],
        "//conditions:default": [],
    }) + select({
        "@//:with_exiv2": ["@exiv2//:exiv2"],
        "//conditions:default": [],
    }),
)

# Helper tool for OpenCL kernel conversion (if needed)
cc_binary(
    name = "embrace",
    srcs = glob(["embrace.cc"], allow_empty = True),
    copts = COMMON_COPTS,
)
