load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "enblend.1",
    "enfuse.1",
])

# Common compiler flags
COMMON_COPTS = [
    "-std=gnu++11",
    "-Wall",
    "-O2",
    "-D_GNU_SOURCE",
    "-D_FILE_OFFSET_BITS=64",
    "-DHAVE_CONFIG_H",
]

ENBLEND_COPTS = COMMON_COPTS + ["-DENBLEND_SOURCE"]
ENFUSE_COPTS = COMMON_COPTS + ["-DENFUSE_SOURCE"]

# Generate a minimal config.h; expand as needed per system
genrule(
    name = "generate_config_h",
    outs = ["config.h"],
    cmd = """
cat > $@ << 'EOF'
#ifndef CONFIG_H
#define CONFIG_H

/* Package version */
#define PACKAGE_VERSION "4.2"
#define VERSION "4.2"
#define PACKAGE_NAME "enblend-enfuse"
#define PACKAGE_STRING "enblend-enfuse 4.2"
#define PACKAGE_BUGREPORT "https://bugs.launchpad.net/enblend"

/* Enable features */
#define HAVE_LIBGSL 1
#define HAVE_LIBJPEG 1
#define HAVE_LIBPNG 1
#define HAVE_LIBTIFF 1
#define HAVE_LIBLCMS2 1

/* Optional features toggles (undef by default) */
/* #define HAVE_EXIV2 1 */
/* #define OPENCL 1 */
/* #define OPENMP 1 */
/* Use Boost.Optional for C++11 */
#define HAVE_BOOST_OPTIONAL_HPP 1

/* System features */
#define HAVE_FENV_H 1
#define HAVE_UNISTD_H 1
#define HAVE_LRINT 1
#define HAVE_LRINTF 1
#define HAVE_MKSTEMP 1
/* Map RESTRICT macro to compiler-specific restrict */
#define RESTRICT __restrict
/* glibc strerror_r returns char* */
#define STRERROR_R_CHAR_P 1
#define HAVE_DECL_STRERROR_R 1

/* Paths */
#define DEFAULT_OPENCL_PATH "/usr/local/share/enblend/kernels:/usr/share/enblend/kernels"

#endif /* CONFIG_H */
EOF
""",
)

# Export config.h with an include path
cc_library(
    name = "config_headers",
    hdrs = [":generate_config_h"],
    includes = ["."],
    visibility = ["//visibility:public"],
)

# Generate signature header
genrule(
    name = "generate_signature",
    srcs = [
        "DefaultSig.pm",
        "Sig.pm",
        "gen_sig",
        "//:VERSION",
    ],
    outs = ["signature.h"],
    cmd = """
        set -e
        PERL_DIR=$$(dirname $(location Sig.pm))
        VER=$$(cat $(location //:VERSION))
        perl -I"$$PERL_DIR" $(location gen_sig) --extra="$$VER" > "$@"
    """,
)

# Collect headers
cc_library(
    name = "headers",
    hdrs = glob(["*.h", "*.hxx", "*.hpp"]) + [":generate_signature"],
    includes = [".", "layer_selection"],
    deps = [":config_headers"],
)

# Common source library
cc_library(
    name = "core",
    srcs = [
        "alternativepercentage.cc",
        "error_message.cc",
        "filenameparse.cc",
        "filespec.cc",
        "introspection.cc",
        "mersenne.cc",
        "metadata.cc",
        "parameter.cc",
        "self_test.cc",
        "tiff_message.cc",
        "timer.cc",
        "minimizer.cc",
        "opencl.cc",
    ],
    hdrs = [],
    copts = COMMON_COPTS,
    includes = ["layer_selection", "dynamic_loader"],
    deps = [
        ":headers",
        "//src/layer_selection:layer_selection",
        "//src/dynamic_loader:dynamic_loader",
        "@boost//:algorithm",
        "@vigra//:vigra",
        "@gsl//:gsl",
    ],
)

# Optional CUDA reduce implementation (stubbed unless --define=with_cuda=true)
config_setting(
    name = "with_cuda",
    define_values = {"with_cuda": "true"},
)

cc_library(
    name = "pyramid_cuda",
    srcs = select({
        ":with_cuda": ["cuda/pyramid_cuda.cu"],
        "//conditions:default": ["cuda/pyramid_cuda_stub.cc"],
    }),
    hdrs = ["cuda/pyramid_cuda.h"],
    copts = COMMON_COPTS,
    features = select({
        ":with_cuda": ["cuda"],
        "//conditions:default": [],
    }),
    linkopts = select({
        ":with_cuda": ["-lcudart"],
        "//conditions:default": [],
    }),
)

# Enblend binary
cc_binary(
    name = "enblend",
    srcs = ["enblend.cc"],
    copts = ENBLEND_COPTS,
    linkopts = ["-lm", "-lpthread"],
    deps = [
        ":core",
        ":pyramid_cuda",
        "//src/layer_selection:layer_selection",
        "//src/dynamic_loader:dynamic_loader",
        "@libtiff//:tiff",
        "@libjpeg//:jpeg",
        "@libpng//:png",
        "@lcms2//:lcms2",
    ] + select({
        "@//:with_openexr": ["@openexr//:openexr"],
        "//conditions:default": [],
    }) + select({
        "@//:with_exiv2": ["@exiv2//:exiv2"],
        "//conditions:default": [],
    }),
)

# Enfuse binary
cc_binary(
    name = "enfuse",
    srcs = ["enfuse.cc", "exposure_weight.cc", "opencl_exposure_weight.cc"],
    copts = ENFUSE_COPTS,
    linkopts = ["-lm", "-lpthread"],
    deps = [
        ":core",
        ":pyramid_cuda",
        "//src/dynamic_loader:dynamic_loader",
        "@libtiff//:tiff",
        "@libjpeg//:jpeg",
        "@libpng//:png",
        "@lcms2//:lcms2",
    ] + select({
        "@//:with_openexr": ["@openexr//:openexr"],
        "//conditions:default": [],
    }) + select({
        "@//:with_exiv2": ["@exiv2//:exiv2"],
        "//conditions:default": [],
    }),
)

# Unit test: CUDA reduce equals CPU reference on small image
cc_test(
    name = "pyramid_cuda_test",
    size = "small",
    srcs = ["pyramid_cuda_test.cc"],
    copts = COMMON_COPTS,
    deps = [":pyramid_cuda", ":headers"],
)
