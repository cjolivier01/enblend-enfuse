# Simplified BUILD file for src/ directory
# This version assumes all source files are in the src/ directory

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

# Common compiler flags
COMMON_COPTS = [
    "-std=c++11",
    "-Wall",
    "-O2",
    "-D_GNU_SOURCE",
    "-D_FILE_OFFSET_BITS=64",
    "-I$(GENDIR)",
    "-I.",
]

ENBLEND_COPTS = COMMON_COPTS + ["-DENBLEND_SOURCE"]
ENFUSE_COPTS = COMMON_COPTS + ["-DENFUSE_SOURCE"]

