#!/usr/bin/env bash
set -euo pipefail

# Prefer bazelisk if available, otherwise fall back to bazel.
if command -v bazelisk >/dev/null 2>&1; then
  BAZEL_CMD=bazelisk
elif command -v bazel >/dev/null 2>&1; then
  BAZEL_CMD=bazel
else
  echo "Error: neither bazelisk nor bazel is installed. Please install Bazel (see README-bazel.md)." >&2
  exit 1
fi

#BAZEL_FLAGS="--config=debug --cpu=$(uname -m)"
BAZEL_FLAGS="--config=debug"

TARGET="$@"
if [ -z "${TARGET}" ]; then
  TARGET="//src:enblend //src:enfuse"
fi

exec "$BAZEL_CMD" build ${BAZEL_FLAGS} ${TARGET}
