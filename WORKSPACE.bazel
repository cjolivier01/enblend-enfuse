# WORKSPACE file for enblend-enfuse project
# Requires Bazel 6.0.0 or later (see .bazelversion file)

workspace(name = "enblend_enfuse")

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Bazel Skylib - Provides useful Starlark functions
http_archive(
    name = "bazel_skylib",
    urls = ["https://github.com/bazelbuild/bazel-skylib/releases/download/1.4.2/bazel-skylib-1.4.2.tar.gz"],
#    sha256 = "66ffd9315665bfaafc96b52278f57c7e2dd09f5ede279ea6d39b2be471e7e3aa",
)

# Rules for C++ compilation
http_archive(
    name = "rules_cc",
    urls = ["https://github.com/bazelbuild/rules_cc/releases/download/0.0.9/rules_cc-0.0.9.tar.gz"],
#    sha256 = "2037875b9a4456dce4a79d112a8ae885bbc4aad968e6587dca6e64f3a0900cdf",
    strip_prefix = "rules_cc-0.0.9",
)

# Boost libraries (using system installation)
new_local_repository(
    name = "boost",
    path = "/usr",  # Adjust path as needed
    build_file_content = """
cc_library(
    name = "filesystem",
    srcs = ["lib/libboost_filesystem.so"],
    hdrs = glob(["include/boost/filesystem/**/*.hpp", "include/boost/filesystem.hpp"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [":system"],
)

cc_library(
    name = "system",
    srcs = ["lib/libboost_system.so"],
    hdrs = glob(["include/boost/system/**/*.hpp"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "algorithm",
    hdrs = glob(["include/boost/algorithm/**/*.hpp"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "math",
    hdrs = glob(["include/boost/math/**/*.hpp"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)
""",
)

