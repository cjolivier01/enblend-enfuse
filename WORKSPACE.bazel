# WORKSPACE file for enblend-enfuse project
# Requires Bazel 6.0.0 or later (see .bazelversion file)

workspace(name = "enblend_enfuse")

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Bazel Skylib - Provides useful Starlark functions
http_archive(
    name = "bazel_skylib",
    urls = ["https://github.com/bazelbuild/bazel-skylib/releases/download/1.4.2/bazel-skylib-1.4.2.tar.gz"],
)

# Rules for C++ compilation
http_archive(
    name = "rules_cc",
    urls = ["https://github.com/bazelbuild/rules_cc/releases/download/0.0.9/rules_cc-0.0.9.tar.gz"],
    strip_prefix = "rules_cc-0.0.9",
)

# Boost libraries (using system installation)
new_local_repository(
    name = "boost",
    path = "/usr",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "filesystem",
    hdrs = glob(["include/boost/**/*.hpp"]),
    includes = ["include"],
    linkopts = ["-lboost_filesystem", "-lboost_system"],
    visibility = ["//visibility:public"],
)
cc_library(
    name = "system",
    hdrs = glob(["include/boost/**/*.hpp"]),
    includes = ["include"],
    linkopts = ["-lboost_system"],
    visibility = ["//visibility:public"],
)
cc_library(
    name = "algorithm",
    hdrs = glob(["include/boost/**/*.hpp"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)
cc_library(
    name = "math",
    hdrs = glob(["include/boost/**/*.hpp"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)
""",
)

